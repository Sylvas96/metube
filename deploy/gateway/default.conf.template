# Passerelle MeTube : seule porte d'entrée. Elle demande à Authelia qui est connecté et transmet le compte à MeTube dans l'en-tête Remote-User.
# ${AUTHELIA_URL} est remplacé au démarrage du conteneur (variable de la pile).

resolver 127.0.0.11 valid=10s ipv6=off;          # DNS interne de Docker

map $http_upgrade $connection_upgrade { default upgrade; '' close; }
map $http_x_forwarded_proto $orig_scheme { default https; http http; }

server {
    listen 80;
    server_tokens off;
    client_max_body_size 10m;

    auth_request /internal/authelia/authz;
    auth_request_set $authelia_user     $upstream_http_remote_user;
    auth_request_set $authelia_redirect $upstream_http_location;
    error_page 401 =302 $authelia_redirect;

    location = /internal/authelia/authz {
        internal;
        proxy_pass ${AUTHELIA_URL}/api/authz/auth-request;
        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Connection "";
        proxy_set_header X-Original-Method $request_method;
        proxy_set_header X-Original-URL $orig_scheme://$http_host$request_uri;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        set $metube http://metube:8081;          # résolu à la demande
        proxy_pass $metube;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header Remote-User $authelia_user;   # écrase toute valeur envoyée par le client
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;                     # fichiers envoyés en flux direct
        proxy_read_timeout 3600s;
    }
}
